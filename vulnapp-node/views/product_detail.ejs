<% const pageTitle = product ? product.name : 'Product' %>
<%- include('_header') %>
<% if (product) { %>
<div class="card">
  <h2 style="margin-top:0;"><%= product.name %></h2>
  <p class="muted"><%= product.description %></p>
  <div class="price">$<%= Number(product.price).toFixed(2) %></div>
</div>

<div class="card">
  <h3 style="margin-top:0;">Comments</h3>
  <% if (!comments || comments.length === 0) { %>
    <p class="muted">No comments yet.</p>
  <% } else { comments.forEach(function(c) { %>
    <div class="comment">
      <strong><%= c.author %></strong>
      <!-- VULN: CWE-79 — <%%- %> is EJS's UNESCAPED output tag. The comment
           body comes straight from the DB with no sanitization, so a
           posted <script> tag executes for every later visitor. -->
      <div><%- c.body %></div>
    </div>
  <% }) } %>

  <h4>Add a comment</h4>
  <form method="POST" action="/product/<%= product.id %>/comments">
    <label>Name</label>
    <input type="text" name="author" placeholder="Your name">
    <label>Comment</label>
    <textarea name="body" rows="3" placeholder="Write something..."></textarea>
    <button type="submit">Post Comment</button>
  </form>
</div>
<% } else { %>
  <p class="muted">Product not found.</p>
<% } %>
<%- include('_footer') %>
